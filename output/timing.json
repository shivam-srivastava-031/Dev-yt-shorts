      "speed": 0.97,
      "lines": [
        {
          "id": "s3_0",
          "cap": "Her car was empty.",
          "hl": false,
          "start": 14.3,
          "end": 15.58223110550062
        },
        {
          "id": "s3_1",
          "cap": "Just the hum of the rails, and her tired reflection.",
