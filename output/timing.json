        {
          "id": "s1_0",
          "cap": "The man behind Maya didn't exist.",
          "hl": false,
          "start": 0.12,
          "end": 2.4317563176473342
        },
        {
          "id": "s1_1",
          "cap": "She could only see him in the window.",
          "hl": false,
          "start": 3.1136218061107606,
          "end": 5.2
        }
      ]
    },
    {
      "id": "s2",
      "start": 5.5,
