      "lines": [
        {
          "id": "s2_0",
          "cap": "2:17 AM.",
          "hl": false,
          "start": 5.8,
          "end": 7.296744279463453
        },
        {
          "id": "s2_1",
          "cap": "Two trains pulled in, side by side.",
